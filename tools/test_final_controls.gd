extends "res://tools/test_intro.gd"
func key(code: int, pressed := true) -> void:
	var event := InputEventKey.new()
	event.physical_keycode = code
	event.pressed = pressed
	Input.parse_input_event(event)
	await frames(2)
func run() -> void:
	await fresh()
	await supplies()
	var p = level.player
	var c = p.controls
	for guard in level.guards():
		guard.set_physics_process(false)
	check(c.slots == ["shank", "c4", "", "", "remote"], "Default numbered slots exclude blanket and reserve 5 for remote")
	await key(KEY_1)
	check(c.active == "shank" and p.attack_cooldown == 0, "Number selects without attacking")
	await key(KEY_1, false)
	p.position = Vector2(180, 236)
	await frames(2)
	await key(KEY_Q)
	check(c.active == "blanket" and not p.is_concealed, "Q selects dedicated blanket")
	c.use_item()
	check(p.is_concealed, "Click/use activates selected blanket")
	p.end_stealth()
	await key(KEY_N)
	check(c.inventory_open and level.controls_locked(), "N opens inventory and locks gameplay")
	c.swap_slot(0)
	c.swap_slot(4)
	check(c.slots[0] == "remote" and c.slots[4] == "shank", "Inventory swaps slot contents")
	c.close_panels()
	var guard = level.guards()[0]
	guard.weapon_kind = "smg"
	p.loot_weapon(guard)
	c.sync_slots()
	c.select_item("smg")
	c.collect_suppressor()
	check(p.suppressor_uses == 3, "Pickup automatically attaches to selected SMG")
	for shot in range(3):
		p.attack_cooldown = 0
		p.fire_gun()
	check(p.suppressor_uses == 0, "SMG breaks suppressor after exactly three rounds")
	c.spares = 1
	await key(KEY_3)
	await frames(65)
	await key(KEY_3, false)
	check(p.suppressor_uses == 3 and c.spares == 0, "Holding gun slot for one second attaches spare suppressor")
	c.reserves.smg = 24
	p.ammunition = 0
	await key(KEY_R)
	check(c.reload_left > 0 and not level.is_queued_for_deletion(), "R starts reload instead of restarting")
	await frames(70)
	check(p.ammunition == 24 and c.reserves.smg == 0, "Reload transfers reserve into magazine")
	c.select_item("c4")
	p.position = Vector2(220, 236)
	c.drop_charge()
	check(c.planted.size() == 1 and p.c4_count == 1, "C4 can be placed without detonating")
	check(c.recover_charge() and p.c4_count == 2, "E interaction can recover undetonated C4")
	c.drop_charge()
	await frames(3)
	c.detonate_charges()
	check(level.door_open and p.c4_count == 1, "Detonating placed C4 breaches cell while preserving story charge")
	c.drop_charge()
	check(c.planted.is_empty(), "Optional C4 cannot spend reserved story charge")
	p.position = Vector2(350, 236)
	await frames(4)
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	await frames(8)
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	check(p.jumps_used == 2 and p.velocity.y < -180, "Second Space press gives a second jump")
	await frames(8)
	var previous: float = p.velocity.y
	Input.action_press("jump")
	await frames(2)
	Input.action_release("jump")
	check(p.jumps_used == 2 and p.velocity.y > previous, "Third jump is rejected")
	await frames(100)
	p.position = Vector2(350, 236)
	await frames(4)
	await key(KEY_CTRL)
	check(p.crouching and p.get_node("CollisionShape2D").shape.size.y == 16, "Ctrl crouches with reduced collision height")
	var roof := StaticBody2D.new()
	var collision := CollisionShape2D.new()
	var shape := RectangleShape2D.new()
	shape.size = Vector2(40, 8)
	collision.shape = shape
	roof.add_child(collision)
	roof.position = p.position + Vector2(0, -12)
	level.add_child(roof)
	await frames(3)
	await key(KEY_CTRL, false)
	check(p.crouching, "Releasing Ctrl under a low ceiling cannot force Miro upright")
	roof.queue_free()
	await frames(4)
	check(not p.crouching, "Miro stands once overhead clearance returns")
	var ledge := StaticBody2D.new()
	var ledge_collision := CollisionShape2D.new()
	var ledge_shape := RectangleShape2D.new()
	ledge_shape.size = Vector2(40, 20)
	ledge_collision.shape = ledge_shape
	ledge.add_child(ledge_collision)
	ledge.position = Vector2(140, 400)
	level.add_child(ledge)
	p.position = Vector2(111, 400)
	p.velocity = Vector2.ZERO
	Input.action_press("move_right")
	await frames(4)
	Input.action_release("move_right")
	check(p.try_mantle() and p.position.x > 120 and p.position.y < 390, "Wall contact can mantle onto a reachable ledge")
	ledge.queue_free()
	c.collect_remote()
	c.open_remote()
	c.run_command("hack")
	check(c.remote_unlocked, "Recovered MP3 player unlocks local terminal mode")
	p.position = level.world_features.access_point
	c.run_command("scan")
	check("service.local" in c.output.text, "First-floor service point supports practice scan")
	c.run_command("login root")
	c.run_command("lights test")
	check("blinked" in c.output.text, "Practice puzzle accepts local login and light script")
	c.close_panels()
	print("FINAL_CONTROLS_RESULT: ", checks - failures.size(), "/", checks, " passed")
	quit(0 if failures.is_empty() else 1)
