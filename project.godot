; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Miro"
config/icon="res://assets/icons/miro_app.png"
config/windows_native_icon="res://assets/icons/miro_app.ico"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

DisplaySettings="*res://scripts/display_settings.gd"

InputBindings="*res://scripts/input_bindings.gd"

Typeface="*res://scripts/typeface.gd"
Campaign="*res://scripts/campaign.gd"
MusicDirector="*res://scripts/music_director.gd"
SpatialAudio="*res://scripts/spatial_audio.gd"
SoundFX="*res://scripts/sound_fx.gd"
ControllerSettings="*res://scripts/controller_settings.gd"
RemoteRadio="*res://scripts/remote_radio.gd"
PlayerBehavior="*res://scripts/player_behavior.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/PirataOne-Regular.ttf"

[rendering]

renderer/rendering_method.macos="gl_compatibility"

textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.09, 1)

[physics]

common/physics_ticks_per_second=360
common/max_physics_steps_per_frame=8
