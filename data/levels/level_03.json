  "number": 3,
  "opening": "A checkpoint splits the tower. The uniforms feel familiar.\nIf I kill the controls, the cameras go blind. The records past it might explain me.",
  "closing": "The voice has a name now.",
  "stations": [
    {
      "id": "RemoteTerminal",
      "title": "Disable the checkpoint controls",
      "position": [
        462.0,
        622
      ],
      "kind": "note",
      "objective": "Disable the checkpoint controls",
      "lines": [
        [
          "CHECKPOINT",
          "Reprogramming complete. Linked security cameras disabled."
        ]
      ],
      "requires": [],
      "status": "implemented: one-second interruptible hack disables linked sweeping cameras"
    },
    {
      "id": "RankRecord",
      "title": "Inspect the former-rank record",
      "position": [
        854.0,
        790
      ],
      "kind": "note",
      "objective": "Inspect the former-rank record",
      "lines": [
        [
          "PERSONNEL RECORD",
          "Miro — former Keeper. Access revoked.\nCharge: treason."
        ],
        [
          "MIRO",
          "My name. Their uniform. I was one of them."
        ],
        [
          "MAINTENANCE CHART",
          "Load junctions: service glyph, upright.\nKeepers only. Do not deface."
        ]
      ],
      "requires": [
        "RemoteTerminal"
      ],
      "status": "draft story"
    },
    {
      "id": "BrotherReveal",
      "title": "Confront the familiar voice",
      "position": [
        798.0,
        1038
      ],
      "kind": "brother",
      "objective": "Confront the familiar voice",
      "lines": [
        [
          "NIRO",
          "Miro. It's Niro. You are my brother.\nYou kept order; I kept the ward. I thought we were helping people."
        ],
        [
          "MIRO",
          "Then neither of us gets to look away."
        ]
      ],
      "requires": [
        "RankRecord"
      ],
      "status": "draft story"
    },
    {
      "id": "ThirdSigil",
      "title": "Place the third sigil",
      "position": [
        658.0,
        1235
      ],
      "kind": "sigil",
      "objective": "Place the third sigil",
      "lines": [
        [
          "MIRO",
          "A Keeper would know where this belongs.\nThat is what frightens me."
        ]
      ],
      "requires": [
        "BrotherReveal"
      ],
      "status": "draft story"
    }
  ],
