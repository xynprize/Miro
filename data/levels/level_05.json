  "number": 5,
  "opening": "At the bottom of the tower, the prison becomes a laboratory.\nThe tower physician is waiting. His brother.",
  "closing": "The ending remains morally unresolved. No explanatory epilogue.",
  "stations": [
    {
      "id": "FinalSigil",
      "title": "Place the final sigil",
      "position": [
        300,
        230
      ],
      "kind": "sigil",
      "objective": "Place the final sigil",
      "lines": [
        [
          "MIRO",
          "The last support. The last mark."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "FinalOffer",
      "title": "Hear the final offer",
      "position": [
        570,
        226
      ],
      "kind": "brother",
      "objective": "Hear the final offer",
      "lines": [
        [
          "LAB RECORD",
          "MIRO \u2014 repeated exposure: no infection.\nAcquired resistance: none. Innate immunity confirmed."
        ],
        [
          "LAB RECORD",
          "Pathogen development: Tower research division.\nCure program: isolate and reproduce subject Miro's resistance."
        ],
        [
          "MIRO",
          "You made the sickness. Then locked me up to take me apart."
        ],
        [
          "BROTHER",
          "The tower made it. They called it progress.\nWhen it escaped, they told me you were our only chance."
        ],
        [
          "BROTHER",
          "You are immune, Miro. I kept you alive.\nI thought if I could understand why, I could save everyone."
        ],
        [
          "MIRO",
          "You told them I was dangerous. You let me believe it."
        ],
        [
          "BROTHER",
          "They said you would destroy the cure if you got out.\nI believed them. I believed keeping you here was love."
        ],
        [
          "MIRO",
          "You do not get to call it love and lock the door."
        ],
        [
          "BROTHER",
          "Stay. Help me finish it. If all of this was for nothing...\nI do not know who I have been."
        ]
      ],
      "requires": [
        "FinalSigil"
      ],
      "status": "draft story"
    },
    {
      "id": "BrotherEncounter",
      "title": "Defeat your brother",
      "position": [
        650,
        414
      ],
      "kind": "brother",
      "objective": "Defeat your brother",
      "lines": [
        [
          "BROTHER",
          "Then come, brother."
        ]
      ],
      "requires": [
        "FinalOffer"
      ],
      "status": "implemented: telegraphed rush and projectile, recovery vulnerability, fatal dialogue handoff"
    },
    {
      "id": "DyingExchange",
      "title": "Listen to your brother",
      "position": [
        410,
        414
      ],
      "kind": "note",
      "objective": "Listen to your brother",
      "lines": [
        [
          "BROTHER",
          "The sick are still real. Whatever the tower did...\ndo not forget them."
        ],
        [
          "BROTHER",
          "I wanted a life where I could keep you safe.\nThey gave me a title, and I mistook it for a choice."
        ],
        [
          "MIRO",
          "You could have come with me."
        ],
        [
          "BROTHER",
          "You are still my brother."
        ]
      ],
      "requires": [
        "BrotherEncounter"
      ],
      "status": "scripted exchange placeholder"
    },
