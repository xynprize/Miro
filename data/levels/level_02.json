  "number": 2,
  "opening": "Below the cells, the coughing has names. Some doors hold the sick,\nothers anyone who stood beside them. Someone is coughing in the first cell. I should look.",
  "closing": "THE VOICE (remote): \"If you go any lower, I can't protect you.\"\nMIRO: \"From who?\"  Static.",
  "stations": [
    {
      "id": "SickPrisoner",
      "title": "Observe the sick prisoner",
      "position": [
        266.0,
        230
      ],
      "kind": "note",
      "objective": "Observe the sick prisoner",
      "lines": [
        [
          "PRISONER",
          "They took everyone in our room. Some of us were never sick.\nI cannot stop shaking. Please... stand back."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "BrotherOffer",
      "title": "Listen to the surrender offer",
      "position": [
        1190.0,
        226
      ],
      "kind": "brother",
      "objective": "Listen to the surrender offer",
      "lines": [
        [
          "THE VOICE",
          "Come back. Let me take you out of here.\nWe used to trust each other."
        ]
      ],
      "requires": [
        "SickPrisoner"
      ],
      "status": "draft story"
    },
    {
      "id": "TransferLedger",
      "title": "Read the indiscriminate transfer order",
      "position": [
        882.0,
        986
      ],
      "kind": "note",
      "objective": "Read the indiscriminate transfer order",
      "lines": [
        [
          "TRANSFER LEDGER",
          "All occupants of affected rooms: detention.\nSymptoms are not required for transfer."
        ],
        [
          "DUTY NOTICE",
          "Keepers reporting symptoms must remain at their posts\nuntil a replacement is authorized."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "SecondSigil",
      "title": "Place the second sigil",
      "position": [
        462.0,
        1235
      ],
      "kind": "sigil",
      "objective": "Place the second sigil",
      "lines": [
        [
          "MIRO",
          "Another support. Another mark.\nI wish I remembered why this feels familiar."
        ]
      ],
      "requires": [
        "BrotherOffer",
        "TransferLedger"
      ],
      "status": "draft story"
    }
  ],
