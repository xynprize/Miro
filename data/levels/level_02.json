      "id": "SickPrisoner",
      "title": "Observe the sick prisoner",
      "position": [
        300,
        230
      ],
      "kind": "note",
      "objective": "Observe the sick prisoner",
      "lines": [
        [
          "PRISONER",
          "They took everyone in our room. Some of us were never sick.\nI cannot stop shaking. Please... stand back."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "BrotherOffer",
      "title": "Listen to the surrender offer",
      "position": [
        580,
        226
      ],
      "kind": "brother",
      "objective": "Listen to the surrender offer",
      "lines": [
        [
          "THE VOICE",
          "Come back. Let me take you out of here.\nWe used to trust each other."
        ],
        [
          "MIRO",
          "Then tell me why these doors are locked from the outside."
        ]
      ],
      "requires": [
        "SickPrisoner"
      ],
      "status": "draft story"
    },
    {
      "id": "TransferLedger",
      "title": "Read the indiscriminate transfer order",
      "position": [
        658,
        404
      ],
      "kind": "note",
      "objective": "Read the indiscriminate transfer order",
      "lines": [
        [
          "TRANSFER LEDGER",
          "All occupants of affected rooms: detention.\nSymptoms are not required for transfer."
        ],
        [
          "DUTY NOTICE",
          "Keepers reporting symptoms must remain at their posts\nuntil a replacement is authorized."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
