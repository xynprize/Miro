  "number": 4,
  "opening": "Sealed rooms. Observation windows. No names on the charts.\nThis was deliberate. The records first, then the seal, then the supports.",
  "closing": "The remote, one last time: \"Don't come down here, Miro. Please.\"\nIt is the first time he begs.",
  "stations": [
    {
      "id": "ExperimentRecords",
      "title": "Inspect the experiment records",
      "position": [
        406.0,
        230
      ],
      "kind": "note",
      "objective": "Inspect the experiment records",
      "lines": [
        [
          "WARD RECORD",
          "Trial continued after consent was withdrawn."
        ],
        [
          "WARD RECORD",
          "Names replaced by specimen numbers."
        ],
        [
          "MIRO",
          "They wrote it down as if that made it acceptable."
        ]
      ],
      "requires": [],
      "status": "draft story"
    },
    {
      "id": "WardRelease",
      "title": "Release the ward seal",
      "position": [
        350.0,
        370
      ],
      "kind": "note",
      "objective": "Release the ward seal",
      "lines": [
        [
          "WARD ACCESS",
          "Manual release. The isolation seal opens."
        ],
        [
          "MIRO",
          "Someone kept these records behind a locked door."
        ]
      ],
      "requires": [
        "ExperimentRecords"
      ],
      "status": "implemented: manual release opens physical ward seal"
    },
    {
      "id": "ContainmentEvidence",
      "title": "Examine the containment evidence",
      "position": [
        1078.0,
        846
      ],
      "kind": "note",
      "objective": "Examine the containment evidence",
      "lines": [
        [
          "OBSERVATION LOG",
          "Symptoms appeared among staff after an isolation failure.\nKeepers were not exempt. Laboratory origin file: sealed."
        ],
        [
          "MIRO",
          "The illness is real. That does not excuse this room."
        ]
      ],
      "requires": ["WardRelease"],
      "status": "draft evidence; exact illness remains open"
    },
    {
      "id": "BrotherWarning",
      "title": "Hear the warning about the ward",
      "position": [
        462.0,
        1038
      ],
      "kind": "brother",
      "objective": "Hear the warning about the ward",
      "lines": [
        [
          "NIRO",
          "I became a doctor to help people. These wards are all I know.\nIf the seals fail, prisoners and Keepers both get sick."
        ],
        [
          "MIRO",
          "Then help them leave. Stop asking them to suffer for this place."
        ],
        [
          "NIRO",
          "They told me there was no other way. I need to believe\nwe can still make this work."
        ]
      ],
      "requires": [
        "ExperimentRecords",
        "ContainmentEvidence"
      ],
      "status": "draft story"
    },
    {
      "id": "WardChargeWest",
      "title": "Plant 2 C4",
      "position": [
        630.0,
        1039
      ],
      "kind": "sigil",
      "objective": "Plant two C4 charges on the ward support",
      "lines": [
        [
          "MIRO",
          "Two charges. Set on the support, linked to the marks."
        ]
      ],
      "requires": [
        "BrotherWarning"
      ],
      "charge_count": 2,
      "status": "implemented: fixed support demolition placement"
    },
    {
      "id": "WardChargeLower",
      "title": "Plant 2 C4",
      "position": [
        1246.0,
        1235
      ],
      "kind": "sigil",
      "objective": "Plant two C4 charges on the lower support",
      "lines": [
        [
          "MIRO",
          "Two charges. Set on the support, linked to the marks."
        ]
      ],
      "requires": [
        "WardChargeWest"
      ],
      "charge_count": 2,
      "status": "implemented: fixed support demolition placement"
    },
    {
      "id": "FourthSigil",
      "title": "Place the penultimate sigil",
      "position": [
        406.0,
        1235
      ],
      "kind": "sigil",
      "objective": "Place the penultimate sigil",
      "lines": [
        [
          "MIRO",
          "Five charges in the ward. The marks on the other floors\nwill carry the signal. There is no taking this back."
        ]
      ],
      "requires": [
        "WardChargeLower"
      ],
      "status": "draft story"
    }
